# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarship_admin

# Application
SESSION_SECRET=change-me-to-a-random-64-char-string
DEV_STUDENT_ID=student-demo-001

# AI eligibility service
AI_SERVICE_URL=http://127.0.0.1:5100

# -----------------------------------------------------------------------
# Google OAuth (required for "Continue with Google" to work)
# -----------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project.
# 3. Navigate to APIs & Services → Credentials → + CREATE CREDENTIALS → OAuth client ID
# 4. Application type: Web application
# 5. Name: ScholarPath Portal (or any name)
# 6. Authorised JavaScript origins (for the GIS one-tap button):
#      http://localhost:3000
# 7. Authorised redirect URIs (for the Authorization-Code flow):
#      http://localhost:5000/api/auth/google/callback
# 8. Click Create, then copy the Client ID and Client Secret below.
#
# For OAuth Consent Screen:
#   - User Type: External (for development)
#   - Add your email under "Test users" if the app is in "Testing" publishing status.
#   - Scopes required: openid, email, profile
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend origin — backend redirects here after OAuth callback
FRONTEND_URL=http://localhost:3000

# Webhook integration
WEBHOOK_RECEIVER_URL=https://your-real-webhook-endpoint.example/webhooks/scholarship
# Optional. If set, every outbound webhook is signed with HMAC-SHA256.
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=30000
